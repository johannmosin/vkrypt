{
  "manifest_version": 3,
  "name": "VKrypt",
  "version": "1.0.0",
  "description": "End-to-end encryption for VK messages with external key exchange",
  "permissions": [
    "storage",
    "activeTab"
  ],
  "host_permissions": [
    "*://vk.com/*",
    "*://*.vk.com/*"
  ],
  "background": {
    "scripts": ["background.js"]
  },
  "content_scripts": [
    {
      "matches": ["*://vk.com/*", "*://*.vk.com/*"],
      "js": ["content.js"],
      "css": ["styles.css"]
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "VKrypt - E2EE for VK",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "vkrypt@extension",
      "strict_min_version": "109.0"
    },
    "gecko_android": {
      "strict_min_version": "109.0"
    }
  }
}
