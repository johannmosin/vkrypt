{
  "manifest_version": 3,
  "name": "VK E2EE Messenger",
  "version": "1.0.0",
  "description": "End-to-End Encryption for VKontakte messages with external key exchange",
  "permissions": [
    "storage",
    "activeTab"
  ],
  "host_permissions": [
    "*://vk.com/*",
    "*://*.vk.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["*://vk.com/*", "*://*.vk.com/*"],
      "js": ["crypto.js", "content.js"],
      "css": ["styles.css"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    },
    "default_title": "VK E2EE Settings"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "vk-e2ee@example.com",
      "strict_min_version": "109.0"
    },
    "gecko_android": {
      "strict_min_version": "113.0"
    }
  }
}
